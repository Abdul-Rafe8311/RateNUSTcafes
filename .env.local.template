# ═══════════════════════════════════════════════════════════════════
#  Concordia Eats — environment variables
#  Copy this file to .env.local and fill in the four values below.
#      cp .env.local.template .env.local
#  .env.local must never be committed — keep it in .gitignore.
# ═══════════════════════════════════════════════════════════════════

# ── Supabase ────────────────────────────────────────────────────────
# supabase.com → your project → Settings → API

# "Project URL". Safe to expose — it ships in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# "anon public" key. Safe to expose; it is restricted by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# "service_role" key. SECRET — bypasses Row Level Security entirely.
# Only ever read from server code (app/api/chatbot/route.ts). Never prefix it
# with NEXT_PUBLIC_, or Next.js will ship it to every visitor's browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Groq (the LLM behind the chatbot) ───────────────────────────────
# console.groq.com → API Keys → Create API Key
# The free tier is enough for development; the key is shown only once, so copy
# it immediately. SECRET — server-side only.
GROQ_API_KEY=gsk_your-groq-key-here
